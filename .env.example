# NOYA CLUB / Amvera staging example
# Never commit real values. Add these via Amvera -> Project -> Variables -> Secrets.
# Use the SAME Supabase project and Cloudflare account as the existing Vercel app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRIVATE_SUPABASE_SERVICE_ROLE_KEY
NOYA_TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRIVATE_TELEGRAM_BOT_TOKEN
# Some legacy admin endpoints need this exact alias to the same Telegram token:
TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRIVATE_TELEGRAM_BOT_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_PRIVATE_CLOUDFLARE_API_TOKEN

# Keep payment collection OFF during staging deployment.
NOYA_PRODAMUS_ENABLE=0
NOYA_PRODAMUS_TEST_MODE=1
NOYA_PRODAMUS_DEMO_MODE=1
NOYA_PRODAMUS_FORM_URL=https://YOUR-EXISTING-PRODAMUS-PAYFORM
NOYA_PRODAMUS_SECRET=REPLACE_WITH_PRIVATE_SIGNING_SECRET
NOYA_PRODAMUS_SUBSCRIPTION_ID=REPLACE_WITH_EXISTING_PRODUCT_ID
NOYA_CLUB_PRICE_RUB=2900
NOYA_CLUB_TERMS_URL=https://YOUR-NEW-AMVERA-DOMAIN/club-terms.html
NOYA_CLUB_RETURN_URL=https://YOUR-NEW-AMVERA-DOMAIN/club.html

# Optional: leave disabled for the first network smoke test.
NOYA_AI_ENABLED=0
OPENAI_API_KEY=REPLACE_WITH_PRIVATE_OPENAI_KEY
NOYA_CLUB_ALLOW_PUBLISH=false

# Video reports and coach reviews: enable ONLY after staffing/capacity and consent are confirmed.
NOYA_PRACTICE_REVIEW_ENABLED=0

# The web service listens on 3000 by default (also set in amvera.yml).
PORT=3000
